# AI coding tool configs (generated by `trellis init`).
# Not versioned to avoid merge conflicts in multi-person collaboration;
# each collaborator runs `trellis init` locally to generate their own copy.
/.agents/
/.claude/
/.codebuddy/
/.codex/
/.zcode/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
dist/
build/

# npm
node_modules/
npm/*.tgz
